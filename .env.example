# Copy to .env.local and fill in. Never commit .env.local — this repo is public.
#
# On Vercel these are provisioned automatically:
#   DATABASE_URL            — injected by the Neon marketplace integration
#   BLOB_READ_WRITE_TOKEN   — injected by Vercel Blob
# Pull them locally with:  vercel env pull .env.local

# --- Neon Postgres -----------------------------------------------------------
# Pooled connection string from the Neon dashboard (or Vercel → Storage).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Better Auth -------------------------------------------------------------
# Signing key for sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Base URL of the app. http://localhost:3000 locally; the deployment URL in prod.
BETTER_AUTH_URL=http://localhost:3000

# --- Vercel Blob -------------------------------------------------------------
# Stores payslip PDFs (replaces the Supabase `payslip-pdfs` bucket).
BLOB_READ_WRITE_TOKEN=
